# LLM API Keys (Store securely on backend proxy only - NEVER in frontend)
# Any of these can be provided; the server automatically falls back in order:
# Gemini -> Groq -> OpenRouter -> Local Ollama -> Built-in Mock Mode

PORT=3001

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Cloud API Key (https://console.groq.com/)
GROQ_API_KEY=

# OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY=

# Local Ollama instance (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
